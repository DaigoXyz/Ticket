@page "/dashboard"
@rendermode InteractiveServer
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject Ticket.Repositories.IRepositories.IEntryTicketRepository TicketRepo
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>Dashboard</h2>
            <p class="text-muted">Selamat datang, @currentUser?.Name</p>
        </div>
        <div class="col-auto">
            <a href="/tickets/create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Buy Ticket
            </a>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-primary">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Total Tickets</h6>
                                <h3 class="mb-0">@totalTickets</h3>
                            </div>
                            <div class="bg-primary bg-opacity-10 p-3 rounded">
                                <i class="bi bi-ticket-perforated fs-3 text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Booked</h6>
                                <h3 class="mb-0">@bookedCount</h3>
                            </div>
                            <div class="bg-success bg-opacity-10 p-3 rounded">
                                <i class="bi bi-calendar-check fs-3 text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-info">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Checked In</h6>
                                <h3 class="mb-0">@checkedInCount</h3>
                            </div>
                            <div class="bg-info bg-opacity-10 p-3 rounded">
                                <i class="bi bi-door-open fs-3 text-info"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Upcoming Tickets</h5>
            </div>
            <div class="card-body">
                @if (upcomingTickets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Tanggal Kunjungan</th>
                                    <th>Keperluan</th>
                                    <th>Status</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in upcomingTickets)
                                {
                                    <tr>
                                        <td>@ticket.VisitDate.ToString("dd MMM yyyy")</td>
                                        <td>@(string.IsNullOrEmpty(ticket.Purpose) ? "-" : ticket.Purpose)</td>
                                        <td>
                                            @if (ticket.Status == "Booked")
                                            {
                                                <span class="badge bg-success">Booked</span>
                                            }
                                            else if (ticket.Status == "CheckedIn")
                                            {
                                                <span class="badge bg-info">Checked In</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@ticket.Status</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="/tickets/@ticket.Id" class="btn btn-sm btn-outline-primary">
                                                Detail
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-inbox fs-1 text-muted"></i>
                        <p class="text-muted mt-2">No upcoming tickets yet</p>
                        <a href="/tickets/create" class="btn btn-primary">Buy Ticket</a>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private Users? currentUser;
    private bool loading = true;
    private List<EntryTickets> userTickets = new();
    private List<EntryTickets> upcomingTickets = new();

    private int totalTickets => userTickets.Count;
    private int bookedCount => userTickets.Count(t => t.Status == "Booked");
    private int checkedInCount => userTickets.Count(t => t.Status == "CheckedIn");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        loading = true;
        StateHasChanged();

        try
        {
            currentUser = await SessionStorage.GetItemAsync<Users>("currentUser");

            if (currentUser == null)
            {
                Nav.NavigateTo("/login", true);
                return;
            }

            if (string.Equals(currentUser.Role, "Admin", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/admin", true);
                return;
            }

            // optional: blok user nonaktif
            if (!currentUser.IsActive)
            {
                // biar nggak loading terus
                return;
            }

            await LoadTickets();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard init error: {ex.Message}");
            // optional: tampilkan error message di UI
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }


    private async Task LoadTickets()
    {
        if (currentUser != null)
        {
            userTickets = await TicketRepo.GetByUserIdAsync(currentUser.Id);
            upcomingTickets = userTickets
            .Where(t => t.VisitDate.Date >= DateTime.Now.Date)
            .OrderBy(t => t.VisitDate)
            .Take(5)
            .ToList();
        }
    }
}