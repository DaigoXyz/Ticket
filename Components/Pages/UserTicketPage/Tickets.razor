@page "/tickets"
@rendermode InteractiveServer
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject Ticket.Repositories.IRepositories.IEntryTicketRepository TicketRepo
@inject NavigationManager Nav
@using Ticket.Models

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>Tiket Saya</h2>
            <p class="text-muted">Kelola semua tiket kunjungan Anda</p>
        </div>
        <div class="col-auto">
            <a href="/tickets/create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Buat Tiket Baru
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text" class="form-control" placeholder="Cari tiket..." @bind="searchTerm"
                        @bind:event="oninput" @onkeyup="FilterTickets" />
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="filterStatus" @bind:after="FilterTickets">
                        <option value="">Semua Status</option>
                        <option value="Booked">Booked</option>
                        <option value="CheckedIn">Checked In</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                @if (filteredTickets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Tanggal Kunjungan</th>
                                    <th>Keperluan</th>
                                    <th>Status</th>
                                    <th>Waktu Masuk</th>
                                    <th>Dibuat</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in filteredTickets)
                                {
                                    <tr>
                                        <td><strong>#@ticket.Id</strong></td>
                                        <td>@ticket.VisitDate.ToString("dd MMM yyyy")</td>
                                        <td>@(string.IsNullOrEmpty(ticket.Purpose) ? "-" : ticket.Purpose)</td>
                                        <td>
                                            @if (ticket.Status == "Booked")
                                            {
                                                <span class="badge bg-success">Booked</span>
                                            }
                                            else if (ticket.Status == "CheckedIn")
                                            {
                                                <span class="badge bg-info">Checked In</span>
                                            }
                                            else if (ticket.Status == "Cancelled")
                                            {
                                                <span class="badge bg-danger">Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@ticket.Status</span>
                                            }
                                        </td>
                                        <td>
                                            @if (ticket.TimeIn.HasValue)
                                            {
                                                @ticket.TimeIn.Value.ToLocalTime().ToString("HH:mm")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@ticket.CreatedAt.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <a href="/tickets/@ticket.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> Detail
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <p class="text-muted mb-0">
                            Menampilkan @filteredTickets.Count dari @allTickets.Count tiket
                        </p>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox fs-1 text-muted"></i>
                        <p class="text-muted mt-2 mb-3">
                            @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(filterStatus))
                            {
                                <span>Tidak ada tiket yang sesuai filter</span>
                            }
                            else
                            {
                                <span>Anda belum memiliki tiket</span>
                            }
                        </p>
                        @if (string.IsNullOrEmpty(searchTerm) && string.IsNullOrEmpty(filterStatus))
                        {
                            <a href="/tickets/create" class="btn btn-primary">Buat Tiket Pertama</a>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private Users? currentUser;
    private bool loading = true;
    private List<EntryTickets> allTickets = new();
    private List<EntryTickets> filteredTickets = new();
    private string searchTerm = string.Empty;
    private string filterStatus = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        loading = true;
        StateHasChanged();

        try
        {
            currentUser = await SessionStorage.GetItemAsync<Users>("currentUser");

            if (currentUser == null)
            {
                Nav.NavigateTo("/login", true);
                return;
            }

            await LoadTickets();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Tickets page init error: {ex}");
            // optional: tampilkan error message di UI
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadTickets()
    {
        if (currentUser != null)
        {
            allTickets = await TicketRepo.GetByUserIdAsync(currentUser.Id);
            filteredTickets = allTickets;
        }
    }

    private void FilterTickets()
    {
        filteredTickets = allTickets;

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filteredTickets = filteredTickets.Where(t =>
            t.Id.ToString().Contains(searchTerm) ||
            (t.Purpose != null && t.Purpose.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }

        if (!string.IsNullOrEmpty(filterStatus))
        {
            filteredTickets = filteredTickets.Where(t => t.Status == filterStatus).ToList();
        }
    }
}