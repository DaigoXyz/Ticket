@page "/tickets"
@rendermode InteractiveServer
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject ITicketProductRepository ProductRepo
@inject NavigationManager Nav
@using Ticket.Models
@using Ticket.Repositories.IRepositories

<div class="container mt-4">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Wujudkan Impian Anda Berpergian</h1>
        <p class="lead text-muted">Pilih tiket terbaik untuk pengalaman tak terlupakan</p>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control border-start-0" placeholder="Cari tiket..." @bind="searchTerm"
                    @bind:event="oninput" @onkeyup="FilterProducts" />
            </div>
        </div>
        <div class="col-md-6 text-end">
            <a href="/my-tickets" class="btn btn-outline-primary">
                <i class="bi bi-ticket-perforated"></i> Tiket Saya
            </a>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-3">Memuat produk tiket...</p>
        </div>
    }
    else
    {
        @if (!filteredProducts.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <h4 class="text-muted mt-3">
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <span>Tidak ada tiket yang sesuai pencarian</span>
                    }
                    else
                    {
                        <span>Belum ada tiket tersedia</span>
                    }
                </h4>
                <p class="text-muted">Silakan cek kembali nanti</p>
            </div>
        }
        else
        {
            <!-- Product Grid -->
            <div class="row g-4">
                @foreach (var product in filteredProducts)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm ticket-card">
                            <div class="card-body d-flex flex-column">
                                <!-- Badge -->
                                <div class="mb-3">
                                    <span class="badge bg-primary">
                                        <i class="bi bi-ticket-perforated-fill"></i> Tersedia
                                    </span>
                                </div>

                                <!-- Product Name -->
                                <h5 class="card-title fw-bold mb-3">@product.Name</h5>

                                <!-- Description -->
                                @if (!string.IsNullOrEmpty(product.Description))
                                {
                                    <p class="card-text text-muted small mb-3">
                                        @product.Description
                                    </p>
                                }
                                else
                                {
                                    <p class="card-text text-muted small mb-3">
                                        <em>Tiket premium untuk pengalaman terbaik</em>
                                    </p>
                                }

                                <!-- Spacer -->
                                <div class="mt-auto">
                                    <!-- Price -->
                                    <div class="d-flex align-items-baseline mb-3">
                                        <h3 class="text-success fw-bold mb-0">
                                            Rp @product.Price.ToString("N0")
                                        </h3>
                                        <span class="text-muted ms-2">/tiket</span>
                                    </div>

                                    <!-- Features List -->
                                    <ul class="list-unstyled small mb-3">
                                        <li class="mb-1">
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                            Berlaku untuk 1 orang
                                        </li>
                                        <li class="mb-1">
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                            Pilih tanggal kunjungan
                                        </li>
                                        <li class="mb-1">
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                            E-ticket digital
                                        </li>
                                    </ul>

                                    <!-- CTA Button -->
                                    <button class="btn btn-primary w-100" @onclick="() => BuyTicket(product.Id)">
                                        <i class="bi bi-cart-plus"></i> Beli Sekarang
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Results Info -->
            <div class="mt-4 text-center">
                <p class="text-muted">
                    Menampilkan @filteredProducts.Count dari @allProducts.Count tiket tersedia
                </p>
            </div>
        }
    }

    <!-- Info Section -->
    <div class="row mt-5 pt-4 border-top">
        <div class="col-md-4 text-center mb-4">
            <i class="bi bi-shield-check fs-1 text-primary"></i>
            <h5 class="mt-3">Aman & Terpercaya</h5>
            <p class="text-muted small">Transaksi dijamin aman dengan sistem yang terpercaya</p>
        </div>
        <div class="col-md-4 text-center mb-4">
            <i class="bi bi-lightning-charge fs-1 text-primary"></i>
            <h5 class="mt-3">Instan</h5>
            <p class="text-muted small">E-ticket langsung dikirim setelah pembayaran</p>
        </div>
        <div class="col-md-4 text-center mb-4">
            <i class="bi bi-headset fs-1 text-primary"></i>
            <h5 class="mt-3">Support 24/7</h5>
            <p class="text-muted small">Tim support siap membantu kapan saja</p>
        </div>
    </div>
</div>

<style>
    .ticket-card {
        transition: all 0.3s ease;
        border: 1px solid #e0e0e0;
    }

    .ticket-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        border-color: var(--bs-primary);
    }
</style>

@code {
    private Users? currentUser;
    private bool loading = true;
    private List<TicketProducts> allProducts = new();
    private List<TicketProducts> filteredProducts = new();
    private string searchTerm = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        loading = true;
        StateHasChanged();

        try
        {
            currentUser = await SessionStorage.GetItemAsync<Users>("currentUser");

            if (currentUser == null)
            {
                Nav.NavigateTo("/login", true);
                return;
            }

            await LoadProducts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Tickets catalog page init error: {ex}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadProducts()
    {
        // Hanya load produk yang aktif
        allProducts = await ProductRepo.GetActiveAsync();
        filteredProducts = allProducts;
    }

    private void FilterProducts()
    {
        filteredProducts = allProducts;

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filteredProducts = filteredProducts.Where(p =>
            p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            (p.Description != null && p.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
    }

    private void BuyTicket(int productId)
    {
        Nav.NavigateTo($"/tickets/buy/{productId}");
    }
}