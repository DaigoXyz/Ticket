@page "/admin/ticket-products"
@rendermode InteractiveServer
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject ITicketProductRepository ProductRepo
@inject NavigationManager Nav
@using Ticket.Models
@using Ticket.Repositories.IRepositories
@using System.ComponentModel.DataAnnotations

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>Manage Ticket Products</h2>
            <p class="text-muted">Kelola produk tiket yang tersedia untuk dibeli</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> Tambah Produk
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text" class="form-control" placeholder="Cari produk..." @bind="searchTerm"
                        @bind:event="oninput" @onkeyup="FilterProducts" />
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="filterStatus" @bind:after="FilterProducts">
                        <option value="">Semua Status</option>
                        <option value="active">Aktif</option>
                        <option value="inactive">Tidak Aktif</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                        <i class="bi bi-x-circle"></i> Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Nama Produk</th>
                                <th>Deskripsi</th>
                                <th>Harga</th>
                                <th>Status</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in filteredProducts)
                            {
                                <tr>
                                    <td>#@product.Id</td>
                                    <td>
                                        <strong>@product.Name</strong>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(product.Description))
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else
                                        {
                                            <span>@(product.Description.Length > 50 ? product.Description.Substring(0, 50) + "..." :
                                                                                    product.Description)</span>
                                        }
                                    </td>
                                    <td>
                                        <strong class="text-success">Rp @product.Price.ToString("N0")</strong>
                                    </td>
                                    <td>
                                        @if (product.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tidak Aktif</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            @if (product.IsActive)
                                            {
                                                <button class="btn btn-outline-warning" @onclick="() => ToggleStatus(product)"
                                                    title="Nonaktifkan">
                                                    <i class="bi bi-toggle-on"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-success" @onclick="() => ToggleStatus(product)"
                                                    title="Aktifkan">
                                                    <i class="bi bi-toggle-off"></i>
                                                </button>
                                            }
                                            <button class="btn btn-outline-primary" @onclick="() => ShowEditModal(product)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => ShowDeleteConfirm(product)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!filteredProducts.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-inbox fs-1 text-muted"></i>
                        <p class="text-muted mt-2">Tidak ada produk yang sesuai filter</p>
                    </div>
                }
                else
                {
                    <p class="text-muted mt-3 mb-0">
                        Menampilkan @filteredProducts.Count dari @allProducts.Count produk
                    </p>
                }
            </div>
        </div>
    }
</div>

<!-- Create/Edit Modal -->
@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Edit Produk Tiket" : "Tambah Produk Tiket")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="productModel" OnValidSubmit="HandleSave">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nama Produk <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="productModel.Name"
                                placeholder="Contoh: Tiket Reguler Weekday" />
                            <ValidationMessage For="() => productModel.Name" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Deskripsi</label>
                            <InputTextArea class="form-control" @bind-Value="productModel.Description" rows="3"
                                placeholder="Deskripsi produk tiket..." />
                            <ValidationMessage For="() => productModel.Description" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Harga (Rp) <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="productModel.Price" placeholder="50000" />
                            <ValidationMessage For="() => productModel.Price" class="text-danger" />
                            <div class="form-text">Masukkan harga dalam Rupiah</div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="productModel.IsActive"
                                    id="isActiveCheck" />
                                <label class="form-check-label" for="isActiveCheck">
                                    Produk Aktif (dapat dibeli user)
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Batal</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @if (saving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Simpan
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && productToDelete != null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Konfirmasi Hapus</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>Apakah Anda yakin ingin menghapus produk tiket ini?</p>
                    <div class="alert alert-warning">
                        <strong>ID:</strong> #@productToDelete.Id<br />
                        <strong>Nama:</strong> @productToDelete.Name<br />
                        <strong>Harga:</strong> Rp @productToDelete.Price.ToString("N0")
                    </div>
                    <p class="text-danger mb-0">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Peringatan:</strong> Aksi ini tidak dapat dibatalkan!
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Batal</button>
                    <button type="button" class="btn btn-danger" @onclick="HandleDelete" disabled="@deleting">
                        @if (deleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Ya, Hapus
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Users? currentUser;
    private bool loading = true;
    private List<TicketProducts> allProducts = new();
    private List<TicketProducts> filteredProducts = new();
    private string searchTerm = string.Empty;
    private string filterStatus = string.Empty;
    private string? successMessage;
    private string? errorMessage;

    // Modal states
    private bool showModal = false;
    private bool showDeleteModal = false;
    private bool isEditMode = false;
    private bool saving = false;
    private bool deleting = false;
    private ProductFormModel productModel = new();
    private TicketProducts? productToDelete;
    private TicketProducts? productToEdit;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        loading = true;
        StateHasChanged();

        try
        {
            currentUser = await SessionStorage.GetItemAsync<Users>("currentUser");

            if (currentUser == null)
            {
                Nav.NavigateTo("/login", true);
                return;
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ticket Products page init error: {ex}");
            errorMessage = "Terjadi kesalahan saat memuat data";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        allProducts = await ProductRepo.GetAllAsync() ?? new();
        filteredProducts = allProducts;
    }

    private void FilterProducts()
    {
        filteredProducts = allProducts;

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filteredProducts = filteredProducts.Where(p =>
            p.Id.ToString().Contains(searchTerm) ||
            p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            (p.Description != null && p.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }

        if (!string.IsNullOrEmpty(filterStatus))
        {
            if (filterStatus == "active")
                filteredProducts = filteredProducts.Where(p => p.IsActive).ToList();
            else if (filterStatus == "inactive")
                filteredProducts = filteredProducts.Where(p => !p.IsActive).ToList();
        }
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        filterStatus = string.Empty;
        FilterProducts();
    }

    private void ShowCreateModal()
    {
        isEditMode = false;
        productModel = new ProductFormModel
        {
            IsActive = true
        };
        showModal = true;
    }

    private void ShowEditModal(TicketProducts product)
    {
        isEditMode = true;
        productToEdit = product;
        productModel = new ProductFormModel
        {
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            IsActive = product.IsActive
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        productModel = new();
        productToEdit = null;
    }

    private async Task HandleSave()
    {
        saving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (isEditMode && productToEdit != null)
            {
                productToEdit.Name = productModel.Name;
                productToEdit.Description = productModel.Description;
                productToEdit.Price = productModel.Price;
                productToEdit.IsActive = productModel.IsActive;

                await ProductRepo.UpdateAsync(productToEdit);
                await ProductRepo.SaveChangesAsync();
                successMessage = "Produk berhasil diupdate!";
            }
            else
            {
                var newProduct = new TicketProducts
                {
                    Name = productModel.Name,
                    Description = productModel.Description,
                    Price = productModel.Price,
                    IsActive = productModel.IsActive
                };

                await ProductRepo.AddAsync(newProduct);
                await ProductRepo.SaveChangesAsync();
                successMessage = "Produk berhasil ditambahkan!";
            }

            await LoadData();
            FilterProducts();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleStatus(TicketProducts product)
    {
        try
        {
            product.IsActive = !product.IsActive;
            await ProductRepo.UpdateAsync(product);
            await ProductRepo.SaveChangesAsync();

            successMessage = $"Status produk '{product.Name}' berhasil diubah menjadi {(product.IsActive ? "Aktif" : "Tidak Aktif")}!";

            await LoadData();
            FilterProducts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void ShowDeleteConfirm(TicketProducts product)
    {
        productToDelete = product;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        productToDelete = null;
    }

    private async Task HandleDelete()
    {
        if (productToDelete == null) return;

        deleting = true;
        errorMessage = null;

        try
        {
            await ProductRepo.DeleteAsync(productToDelete.Id);
            await ProductRepo.SaveChangesAsync();
            successMessage = $"Produk '{productToDelete.Name}' berhasil dihapus!";

            await LoadData();
            FilterProducts();
            CloseDeleteModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            deleting = false;
        }
    }

    public class ProductFormModel
    {
        [Required(ErrorMessage = "Nama produk harus diisi")]
        [StringLength(200, ErrorMessage = "Nama produk maksimal 200 karakter")]
        public string Name { get; set; } = string.Empty;

        [StringLength(1000, ErrorMessage = "Deskripsi maksimal 1000 karakter")]
        public string? Description { get; set; }

        [Required(ErrorMessage = "Harga harus diisi")]
        [Range(0, 999999999, ErrorMessage = "Harga harus antara 0 - 999.999.999")]
        public decimal Price { get; set; }

        public bool IsActive { get; set; } = true;
    }
}