@page "/register"
@rendermode InteractiveServer
@layout Ticket.Components.Layout.AuthLayout
@inject Ticket.Services.User.IUserService Users
@inject NavigationManager Nav
@using Ticket.DTOs.Auth

<div class="container py-5" style="max-width:560px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h3 class="mb-3">Register</h3>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger">@error</div>
            }
            @if (!string.IsNullOrWhiteSpace(success))
            {
                <div class="alert alert-success">@success</div>
            }

            <EditForm Model="model" OnValidSubmit="DoRegister">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Nama</label>
                    <InputText class="form-control" @bind-Value="model.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <InputText class="form-control" @bind-Value="model.Username" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText class="form-control" type="password" @bind-Value="model.Password" />
                </div>

                <button class="btn btn-success w-100" type="submit" disabled="@loading">
                    @(loading ? "Loading..." : "Register")
                </button>
            </EditForm>

            <div class="mt-3 text-center">
                Sudah punya akun? <a href="/login">Login</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string? error;
    private string? success;
    private bool loading;

    private RegisterDto model = new();

    private async Task DoRegister()
    {
        error = null;
        success = null;
        loading = true;

        var (ok, msg) = await Users.RegisterAsync(model.Username, model.Name, model.Password);

        loading = false;

        if (!ok)
        {
            error = msg;
            return;
        }

        success = msg;
        Nav.NavigateTo("/login", true);
    }
}