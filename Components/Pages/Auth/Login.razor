@page "/login"
@rendermode InteractiveServer
@layout Ticket.Components.Layout.AuthLayout
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject Ticket.Services.Auth.IAuthService Auth
@inject Ticket.Services.State.AuthState State
@inject NavigationManager Nav

<div class="card shadow-sm" style="width: 420px;">
    <div class="card-body p-4">
        <h3 class="mb-3">Login</h3>
        <p class="text-muted mb-4">Silakan masuk untuk lanjut.</p>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <EditForm Model="model" OnValidSubmit="DoLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Username</label>
                <InputText class="form-control" @bind-Value="model.Username" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText class="form-control" type="password" @bind-Value="model.Password" />
            </div>

            <button class="btn btn-primary w-100" type="submit" disabled="@loading">
                @(loading ? "Loading..." : "Login")
            </button>
        </EditForm>

        <div class="mt-3 text-center">
            Belum punya akun? <a href="/register">Register</a>
        </div>
    </div>
</div>

@code {
    private string? error;
    private bool loading;
    private LoginRequestDto model = new();

    private async Task DoLogin()
    {
        error = null;
        loading = true;

        var (ok, msg) = await Auth.LoginAsync(model.Username, model.Password);

        if (!ok)
        {
            error = msg;
            loading = false;
            return;
        }

        await SessionStorage.SetItemAsync("currentUser", State.CurrentUser);

        var storedUser = await SessionStorage.GetItemAsync<Users>("currentUser");

        var isAdmin = string.Equals(storedUser?.Role, "Admin", StringComparison.OrdinalIgnoreCase);

        if (isAdmin)
        {
            Nav.NavigateTo("/admin", true);
        }
        else
        {
            Nav.NavigateTo("/dashboard", true);
        }

        loading = false;
    }
}